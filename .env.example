# Copy to .env and provide credentials/configuration when implementing integrations.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=45
BACKEND_URL=http://backend:8000
CHROMA_PERSIST_DIRECTORY=/app/data/chroma
CHROMA_COLLECTION_NAME=real_estate_documents
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=4
CHAT_HISTORY_TURN_LIMIT=6
DARGLOBAL_START_URLS=https://darglobal.co.uk/,https://darglobal.co.uk/about,https://darglobal.co.uk/projects,https://darglobal.co.uk/media,https://darglobal.co.uk/investor-relations,https://darglobal.co.uk/contact,https://darglobal.co.uk/careers
WASALT_START_URLS=https://wasalt.com/
SCRAPER_OUTPUT_PATH=data/raw/collected_documents.jsonl
LOG_LEVEL=INFO
